# Copy to .env (build-time and scripts) and .dev.vars (wrangler dev). Never commit the real values.
# Locally everything is optional: without a database the dev server uses PGlite in .local/pglite,
# without storage it uses .local/storage, without Brevo mails are printed to the terminal.

# Database (Neon). tz_app for the Worker, tz_build (read-only) for the build, owner role for migrations.
DATABASE_URL=
DATABASE_URL_BUILD=
DATABASE_URL_MIGRATE=

# Neon Object Storage (S3-compatible), bucket "media"
STORAGE_ENDPOINT=
STORAGE_BUCKET=media
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_READ_KEY_ID=
STORAGE_READ_SECRET=

# CMS sign-in
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Empty locally = gate off. Deployed without it, /admin stays closed.
ADMIN_UNLOCK_KEY=
# Only for npm run seed:account
ADMIN_EMAIL=

# Mail (Brevo)
BREVO_API_KEY=
MAIL_FROM=noreply@tuinzorgdp.be
MAIL_FROM_NAME=TuinZorg DP
MAIL_REPLY_TO=info@tuinzorgdp.be

# Publishing and cron
DEPLOY_HOOK_URL=
CRON_SECRET=

# Public site (build variables)
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Set to true only after the domain move; until then the build sends noindex and blocks crawlers.
SITE_INDEXABLE=false
# Forms without JavaScript are accepted (honeypot + rate limit only). Set to false to require Turnstile.
ALLOW_NOJS_SUBMIT=true

# Google rating (only if the Places API is approved)
GOOGLE_PLACES_KEY=
